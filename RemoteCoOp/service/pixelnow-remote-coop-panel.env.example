# Optional panel overrides. Install scripts create /etc/pixelnow/remote-coop-panel.env when absent.
PIXELNOW_REMOTE_COOP_PANEL_BIND_HOST=0.0.0.0
PIXELNOW_REMOTE_COOP_PANEL_PORT=32187
PIXELNOW_REMOTE_COOP_PANEL_ALLOWED_GROUPS=pixelnow-coop-admin
PIXELNOW_REMOTE_COOP_PANEL_UPDATE_AUTOMATIC=1
PIXELNOW_REMOTE_COOP_PANEL_UPDATE_INTERVAL_SECONDS=300
PIXELNOW_REMOTE_COOP_PANEL_UPDATE_VALIDATE=node RemoteCoOp/run-servers.mjs --dry-run

# Remote Co-Op server defaults used by the managed child process.
PIXELNOW_REMOTE_COOP_PUBLIC_HOST=198.12.95.48
PIXELNOW_REMOTE_COOP_PORT=32188
PIXELNOW_REMOTE_COOP_TURN_PORT=32189
PIXELNOW_REMOTE_COOP_TURN_TLS_PORT=32443
PIXELNOW_REMOTE_COOP_TURN_MIN_PORT=42160
PIXELNOW_REMOTE_COOP_TURN_MAX_PORT=42200
PIXELNOW_REMOTE_COOP_AUTOSTART=1

# Production deployments should keep this stable. Install scripts generate it when absent.
PIXELNOW_REMOTE_COOP_TURN_SHARED_SECRET=replace-with-long-random-secret
